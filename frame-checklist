<body>

<div id="app">

  <div id="topbar">
    <button class="icon-btn" id="btnBack" style="visibility:hidden;">&#8592;</button>
    <div style="flex:1;min-width:0;">
      <div class="brand" id="brandLabel">Frame Checklist</div>
      <div id="jobHeader"></div>
    </div>
    <button class="icon-btn" id="btnSettings">&#9881;</button>
  </div>

  <div id="content">

    <!-- ===================== SETUP SCREEN ===================== -->
    <div class="screen" id="screen-setup">
      <div class="pad">
        <div class="card">
          <h1>Connect to Smartsheet</h1>
          <p class="sub">
            This app talks to Smartsheet through your Cloudflare proxy — it
            never holds the real Smartsheet token. Enter the proxy's details
            below (see WORKER-SETUP.md).
          </p>
          <div class="row-gap">
            <label class="field-label">Worker URL</label>
            <input type="text" id="workerUrlInput" placeholder="https://smartsheet-proxy.xxxx.workers.dev" autocomplete="off">
          </div>
          <div class="row-gap">
            <label class="field-label">App Key</label>
            <input type="password" id="appKeyInput" placeholder="Paste app key here" autocomplete="off">
          </div>
          <button class="btn" id="btnSaveToken">Save &amp; continue</button>
        </div>
      </div>
    </div>

    <!-- ===================== JOB LIST SCREEN ===================== -->
    <div class="screen" id="screen-jobs">
      <div class="pad">
        <button class="btn secondary row-gap" id="btnRefreshJobs">Refresh list</button>
        <div id="jobListContainer"></div>
      </div>
    </div>

    <!-- ===================== REPORT TAB ===================== -->
    <div class="screen" id="screen-report">
      <div id="reportSummary">
        <div class="count"><span class="n" id="doneCount">0</span> / <span id="totalCount">0</span> frames done</div>
        <button class="btn" style="width:auto;min-height:40px;padding:0 16px;font-size:13px;" id="btnSaveProgress">Save Progress</button>
      </div>
      <div id="frameList"></div>
    </div>

    <!-- ===================== DRAWINGS TAB ===================== -->
    <div class="screen" id="screen-drawings">
      <div id="drawingsViewport">
        <canvas id="drawingCanvas"></canvas>
        <button id="drawingsPrev" style="display:none;">&#8249;</button>
        <button id="drawingsNext" style="display:none;">&#8250;</button>
        <div id="pageIndicator"></div>
      </div>
    </div>

    <!-- ===================== SETTINGS SCREEN ===================== -->
    <div class="screen" id="screen-settings">
      <div class="pad">
        <div class="card">
          <h2>Connection</h2>
          <div class="kv"><div class="k">Worker URL</div><div id="workerUrlStatus">Not set</div></div>
          <div class="kv"><div class="k">App key</div><div id="appKeyStatus">Not set</div></div>
          <button class="btn outline row-gap" style="margin-top:12px;" id="btnChangeToken">Change connection</button>
        </div>
        <div class="card">
          <h2>About this app</h2>
          <p class="sub" style="margin-bottom:0;">
            Frame Checklist reads FRAMECAD work orders from Smartsheet (via your
            Cloudflare proxy), auto-fetches the detailer report and production
            drawings attached to each job, and lets you check off frames as
            they're completed. Saving progress uploads a marked-up copy of the
            detailer report back to the job's row as a new version of the
            "IN PROGRESS" file.
          </p>
        </div>
        <div class="card">
          <h2>Known limitations</h2>
          <p class="sub" style="margin-bottom:0;">
            &bull; Report/drawing matching is by filename pattern — if it guesses wrong, use
            the "Pick files" option that appears on the job screen.<br><br>
            &bull; Uploads made by this app all show as authored by whichever
            Smartsheet account the proxy's token belongs to, not the tablet's user.<br><br>
            &bull; Files over 30MB can't be uploaded via the API (Smartsheet's limit).
          </p>
        </div>
      </div>
    </div>

  </div>

  <div id="tabbar" style="display:none;">
    <button data-tab="jobs"><span class="ic">&#128203;</span>Jobs</button>
    <button data-tab="report"><span class="ic">&#9989;</span>Report</button>
    <button data-tab="drawings"><span class="ic">&#128196;</span>Drawings</button>
  </div>

</div>

<div id="toast"></div>

<div id="modalOverlay">
  <div id="modalSheet">
    <h2 id="modalTitle">Pick a file</h2>
    <div id="modalList"></div>
    <button class="btn outline" style="margin-top:10px;" onclick="closeModal()">Cancel</button>
  </div>
</div>

<script>
/* =========================================================================
   CONFIG
   ========================================================================= */
const CONFIG = {
  REPORT_ID: '7888733526249348',        // FRAMECAD - Work Orders Schedule
  WORK_ORDER_SHEET_ID: '8417646009601924', // "Work Order" source sheet
  JOB_TYPE_FILTER: 'FRAMECAD',
  UPLOAD_CAP_BYTES: 30 * 1024 * 1024,
  // Filenames matching this are treated as the detailer report (Plan Material
  // Summary). Adjust if your FrameCAD export naming convention differs.
  DETAILER_NAME_RE: /^\d{2,3}_.+\.pdf$/i,
  // Filenames matching this are treated as production drawings.
  DRAWINGS_NAME_RE: /(zone|panels|-\d{3,5}-|LGS)/i,
  IN_PROGRESS_ATTACHMENT_RE: /^IN PROGRESS[: ]/i
};

/* =========================================================================
   STORAGE HELPERS
   ========================================================================= */
const Store = {
  getWorkerUrl(){ return (localStorage.getItem('fc_worker_url') || '').replace(/\/+$/,''); },
  setWorkerUrl(u){ localStorage.setItem('fc_worker_url', u.replace(/\/+$/,'')); },
  getAppKey(){ return localStorage.getItem('fc_app_key') || ''; },
  setAppKey(k){ localStorage.setItem('fc_app_key', k); },
  isConfigured(){ return !!(this.getWorkerUrl() && this.getAppKey()); },

  // Per-job checklist progress, keyed by row id.
  getJobState(rowId){
    try{ return JSON.parse(localStorage.getItem('fc_job_'+rowId) || 'null'); }
    catch(e){ return null; }
  },
  setJobState(rowId, state){
    localStorage.setItem('fc_job_'+rowId, JSON.stringify(state));
  }
};

/* =========================================================================
   TOAST
   ========================================================================= */
let toastTimer = null;
function toast(msg, kind){
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.className = 'show' + (kind ? ' '+kind : '');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>{ el.classList.remove('show'); }, 3200);
}

/* =========================================================================
   PROXY CLIENT — everything goes through the Cloudflare Worker, never
   directly to api.smartsheet.com (which sends no CORS headers at all).
   ========================================================================= */

// GET a JSON endpoint via the proxy's /api/* passthrough.
async function ssGet(path){
  const workerUrl = Store.getWorkerUrl();
  if(!workerUrl) throw new Error('Worker URL not set');
  let res;
  try{
    res = await fetch(workerUrl + '/api' + path, {
      headers: { 'X-App-Key': Store.getAppKey() }
    });
  }catch(e){
    throw new Error('Could not reach the proxy at ' + workerUrl + ' (' + e.message + ')');
  }
  const body = await res.json().catch(()=> ({}));
  if(!res.ok) throw new Error('Smartsheet error ' + res.status + ': ' + (body.message || body.error || JSON.stringify(body).slice(0,150)));
  return body;
}

// Download attachment bytes — proxy resolves the 60-second pre-signed URL
// and streams the bytes back in one round trip.
async function downloadAttachmentBytes(sheetId, attachmentId){
  const workerUrl = Store.getWorkerUrl();
  const res = await fetch(
    workerUrl + '/download?sheetId=' + sheetId + '&attachmentId=' + attachmentId,
    { headers: { 'X-App-Key': Store.getAppKey() } }
  );
  if(!res.ok){
    const body = await res.json().catch(()=> ({}));
    throw new Error('Download failed: ' + (body.error || res.status));
  }
  return await res.arrayBuffer();
}

// Upload raw bytes as a new attachment or a new version of an existing one.
async function uploadAttachmentBytes(sheetId, {rowId, attachmentId, filename, mode}, bytes){
  if(bytes.byteLength > CONFIG.UPLOAD_CAP_BYTES){
    throw new Error('File is over Smartsheet\'s 30MB API upload limit');
  }
  const workerUrl = Store.getWorkerUrl();
  const params = new URLSearchParams({ sheetId, filename, mode: mode || 'new' });
  if(rowId) params.set('rowId', rowId);
  if(attachmentId) params.set('attachmentId', attachmentId);

  const res = await fetch(workerUrl + '/upload?' + params.toString(), {
    method: 'POST',
    headers: {
      'X-App-Key': Store.getAppKey(),
      'X-Content-Type': 'application/pdf'
    },
    body: bytes
  });
  const body = await res.json().catch(()=> ({}));
  if(!res.ok) throw new Error('Upload failed: ' + (body.message || body.error || res.status));
  return body;
}

/* =========================================================================
   SMARTSHEET DATA HELPERS
   ========================================================================= */
async function getWorkOrders(){
  const data = await ssGet('/reports/' + CONFIG.REPORT_ID + '?pageSize=500');
  // Map column titles -> virtualColumnId for this report.
  const colByTitle = {};
  data.columns.forEach(c => { colByTitle[c.title] = c.virtualId; });

  function cellFor(row, title){
    const vid = colByTitle[title];
    return (row.cells || []).find(c => c.virtualColumnId === vid);
  }
  // Per the methodology doc: read `value`, not `displayValue` — a picklist's
  // value is already the display string, but numbers/dates read raw in value.
  function cellValue(cell){
    if(!cell) return '';
    return (cell.value !== undefined && cell.value !== null) ? cell.value : (cell.displayValue || '');
  }

  const jobs = (data.rows || []).map(row => ({
    rowId: row.id,
    sheetId: row.sheetId,
    workOrderType: cellValue(cellFor(row, 'Work Order Type')),
    zone: cellValue(cellFor(row, 'Project & Zone Number')) || '(no zone)',
    complete: cellValue(cellFor(row, 'Complete')) || 'Not Started',
    startDate: cellValue(cellFor(row, 'Scheduled Start Date')) || null,
    endDate: cellValue(cellFor(row, 'Scheduled End Date')) || null
  })).filter(j => (j.workOrderType || '').toUpperCase() === CONFIG.JOB_TYPE_FILTER
               && j.complete !== 'Complete');

  jobs.sort((a,b) => (a.startDate||'').localeCompare(b.startDate||''));
  return jobs;
}

// Row-scoped listing only — sheet-scoped listing on a sheet this size would
// mean pulling thousands of attachments to find a dozen (per the methodology
// doc's measured 10s vs 1s difference).
async function getRowAttachments(sheetId, rowId){
  const data = await ssGet('/sheets/' + sheetId + '/rows/' + rowId + '/attachments?includeAll=true');
  return (data.data || []).filter(a => a.attachmentType === 'FILE');
}

// Re-resolves the *live* attachment ID immediately before a write — never
// reuse an ID fetched earlier, since a version bump changes it.
async function resolveLiveAttachment(sheetId, rowId, name){
  const attachments = await getRowAttachments(sheetId, rowId);
  const matches = attachments.filter(a => a.name === name);
  if(!matches.length) return null;
  matches.sort((a,b) => (a.createdAt||'').localeCompare(b.createdAt||''));
  return matches[matches.length - 1];
}

/* =========================================================================
   PDF PARSING (pdf.js)
   ========================================================================= */
pdfjsLib.GlobalWorkerOptions.workerSrc =
  'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

async function loadPdf(arrayBuffer){
  const task = pdfjsLib.getDocument({data: arrayBuffer});
  return await task.promise;
}

// Groups text items on a page into visual rows by rounded Y position.
async function getPageRows(page){
  const content = await page.getTextContent();
  const rows = {};
  content.items.forEach(item => {
    const y = Math.round(item.transform[5]);
    const x = item.transform[4];
    const key = y;
    if(!rows[key]) rows[key] = [];
    rows[key].push({x, y, str: item.str});
  });
  return Object.keys(rows).map(y => {
    const items = rows[y].sort((a,b)=>a.x-b.x);
    return { y: parseFloat(y), items, text: items.map(i=>i.str).join(' ').replace(/\s+/g,' ').trim() };
  }).sort((a,b)=> b.y - a.y);
}

// Parses the "Plan Material Summary" detailer report: header info + frame table.
async function extractDetailerReport(pdfDoc){
  let header = { client:'', jobNumber:'', title:'', sectionTitle:'', frameCount:null };
  const frames = [];
  const rowRe = /^([A-Za-z0-9\-]+)\s+([\d.]+)\s*m\s+([\d.]+)\s*m\s+([\d.]+)\s*m\s+(\d+)\s+([\d.]+)\s*kg\s+([\d.]+)\s*kg\s+([\d.]+)\s*kg$/;

  for(let p = 1; p <= pdfDoc.numPages; p++){
    const page = await pdfDoc.getPage(p);
    const rows = await getPageRows(page);

    rows.forEach(r => {
      if(!header.jobNumber){
        const jm = r.text.match(/Job Number\s+(\S+)/i);
        if(jm) header.jobNumber = jm[1];
      }
      if(!header.client){
        const cm = r.text.match(/^Client\s+(.+)$/i);
        if(cm) header.client = cm[1].trim();
      }
      if(!header.title && p===1){
        if(r.text.length > 3 && !/plan material summary/i.test(r.text)) header.title = r.text;
      }
      const countMatch = r.text.match(/Frame Count\s*:\s*(\d+)/i);
      if(countMatch){
        header.frameCount = parseInt(countMatch[1], 10);
      }
      const rowMatch = r.text.match(rowRe);
      if(rowMatch){
        frames.push({
          name: rowMatch[1],
          plateLength: rowMatch[2] + ' m',
          studLength: rowMatch[3] + ' m',
          totalLength: rowMatch[4] + ' m',
          fasteners: rowMatch[5],
          plateWeight: rowMatch[6] + ' kg',
          studWeight: rowMatch[7] + ' kg',
          totalWeight: rowMatch[8] + ' kg',
          page: p,
          y: r.y,
          x: r.items[0].x
        });
      }
    });

    if(header.frameCount !== null && !header.sectionTitle){
      const idx = rows.findIndex(r => /Frame Count\s*:/i.test(r.text));
      if(idx > 0) header.sectionTitle = rows[idx-1].text;
    }
  }

  return { header, frames };
}

/* =========================================================================
   PDF ANNOTATION (pdf-lib) — marks completed frame rows on a copy of the
   original detailer report before it's uploaded back to Smartsheet.
   ========================================================================= */
async function annotateDetailerPdf(originalBytes, frames, doneSet){
  const { PDFDocument, rgb } = PDFLib;
  const pdfDoc = await PDFDocument.load(originalBytes);
  const pages = pdfDoc.getPages();

  frames.forEach(f => {
    if(!doneSet.has(f.name)) return;
    const page = pages[f.page - 1];
    if(!page) return;
    const { width } = page.getSize();
    page.drawRectangle({
      x: 40, y: f.y - 3, width: width - 80, height: 14,
      color: rgb(0.83, 0.93, 0.84), opacity: 0.7
    });
    page.drawText('OK', {
      x: 18, y: f.y - 2, size: 9, color: rgb(0.15, 0.45, 0.2)
    });
  });

  return await pdfDoc.save();
}

/* =========================================================================
   APP STATE
   ========================================================================= */
const AppState = {
  jobs: [],
  currentJob: null,
  detailerBytes: null,
  drawingsBytes: null,
  drawingsPdf: null,
  drawingsPage: 1,
  drawingsPageCount: 0,
  frames: [],
  header: null,
  doneSet: new Set(),
  candidateAttachments: []
};

/* =========================================================================
   NAVIGATION
   ========================================================================= */
function showScreen(id){
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}
function setTabbarVisible(v){
  document.getElementById('tabbar').style.display = v ? 'flex' : 'none';
}
function setActiveTab(tab){
  document.querySelectorAll('#tabbar button').forEach(b=>{
    b.classList.toggle('active', b.dataset.tab === tab);
  });
}
document.querySelectorAll('#tabbar button').forEach(btn => {
  btn.addEventListener('click', () => {
    const tab = btn.dataset.tab;
    if(tab === 'jobs'){
      document.getElementById('btnBack').style.visibility = 'hidden';
      document.getElementById('jobHeader').textContent = '';
      showScreen('screen-jobs');
    } else if(tab === 'report'){
      showScreen('screen-report');
    } else if(tab === 'drawings'){
      showScreen('screen-drawings');
      renderDrawingPage();
    }
    setActiveTab(tab);
  });
});
document.getElementById('btnBack').addEventListener('click', () => {
  document.getElementById('btnBack').style.visibility = 'hidden';
  document.getElementById('jobHeader').textContent = '';
  showScreen('screen-jobs');
  setTabbarVisible(false);
});
document.getElementById('btnSettings').addEventListener('click', () => {
  document.getElementById('workerUrlStatus').textContent = Store.getWorkerUrl() || 'Not set';
  document.getElementById('appKeyStatus').textContent = Store.getAppKey() ? 'Saved on this device' : 'Not set';
  showScreen('screen-settings');
});

/* =========================================================================
   SETUP / CONNECTION
   ========================================================================= */
document.getElementById('btnSaveToken').addEventListener('click', () => {
  const u = document.getElementById('workerUrlInput').value.trim();
  const k = document.getElementById('appKeyInput').value.trim();
  if(!u || !k){ toast('Enter both the Worker URL and App Key', 'err'); return; }
  Store.setWorkerUrl(u);
  Store.setAppKey(k);
  toast('Connected', 'ok');
  boot();
});
document.getElementById('btnChangeToken').addEventListener('click', () => {
  document.getElementById('workerUrlInput').value = Store.getWorkerUrl();
  document.getElementById('appKeyInput').value = Store.getAppKey();
  showScreen('screen-setup');
});

/* =========================================================================
   JOB LIST
   ========================================================================= */
document.getElementById('btnRefreshJobs').addEventListener('click', loadJobs);

async function loadJobs(){
  const container = document.getElementById('jobListContainer');
  container.innerHTML = '<div class="spinner"></div>';
  try{
    AppState.jobs = await getWorkOrders();
    renderJobList();
  }catch(e){
    container.innerHTML = '<div class="empty">Couldn\'t load jobs.<br>' + escapeHtml(e.message) + '</div>';
  }
}

function renderJobList(){
  const container = document.getElementById('jobListContainer');
  if(!AppState.jobs.length){
    container.innerHTML = '<div class="empty">No scheduled FRAMECAD jobs found.</div>';
    return;
  }
  container.innerHTML = '';
  AppState.jobs.forEach(job => {
    const badgeClass = job.complete === 'Partially Complete' ? 'partial' : 'not-started';
    const div = document.createElement('div');
    div.className = 'job-card';
    div.innerHTML =
      '<div class="zone">' + escapeHtml(job.zone) + '</div>' +
      '<div class="meta">' +
        (job.startDate ? '<span>Start: ' + escapeHtml(job.startDate) + '</span>' : '') +
        (job.endDate ? '<span>End: ' + escapeHtml(job.endDate) + '</span>' : '') +
        '<span class="badge ' + badgeClass + '">' + escapeHtml(job.complete || 'Not Started') + '</span>' +
      '</div>';
    div.addEventListener('click', () => openJob(job));
    container.appendChild(div);
  });
}

/* =========================================================================
   OPEN A JOB — fetch attachments, classify, load report + drawings
   ========================================================================= */
async function openJob(job){
  AppState.currentJob = job;
  document.getElementById('jobHeader').textContent = job.zone;
  document.getElementById('btnBack').style.visibility = 'visible';
  showScreen('screen-report');
  document.getElementById('frameList').innerHTML = '<div class="spinner"></div>';

  try{
    const attachments = await getRowAttachments(job.sheetId, job.rowId);
    const pdfAttachments = attachments.filter(a =>
      (a.name||'').toLowerCase().endsWith('.pdf') &&
      !CONFIG.IN_PROGRESS_ATTACHMENT_RE.test(a.name||'')
    );

    let detailerAtt = pdfAttachments.find(a => CONFIG.DETAILER_NAME_RE.test(a.name));
    let drawingsAtt = pdfAttachments.find(a => a !== detailerAtt && CONFIG.DRAWINGS_NAME_RE.test(a.name));

    if(!detailerAtt || !drawingsAtt){
      AppState.candidateAttachments = pdfAttachments;
      pickAttachmentsManually(pdfAttachments, detailerAtt, drawingsAtt);
      return;
    }

    await loadJobFiles(detailerAtt, drawingsAtt);
  }catch(e){
    document.getElementById('frameList').innerHTML =
      '<div class="empty">Couldn\'t load this job.<br>' + escapeHtml(e.message) + '</div>';
  }
}

function pickAttachmentsManually(list, guessedDetailer, guessedDrawings){
  if(!list.length){
    document.getElementById('frameList').innerHTML =
      '<div class="empty">No PDF attachments found on this row yet.</div>';
    return;
  }
  openModal('Which file is the detailer report?', list, async (detailerAtt) => {
    const rest = list.filter(a => a !== detailerAtt);
    if(rest.length === 1){
      await loadJobFiles(detailerAtt, rest[0]);
    } else {
      openModal('Which file has the production drawings?', rest, async (drawingsAtt) => {
        await loadJobFiles(detailerAtt, drawingsAtt);
      });
    }
  }, guessedDetailer);
}

function openModal(title, list, cb, highlighted){
  document.getElementById('modalTitle').textContent = title;
  const listEl = document.getElementById('modalList');
  listEl.innerHTML = '';
  list.forEach(att => {
    const row = document.createElement('div');
    row.className = 'pick-row';
    row.innerHTML = '<div class="fname">' + escapeHtml(att.name) +
      (att === highlighted ? '  <span style="color:var(--orange);">(likely)</span>' : '') + '</div>' +
      '<div class="fdate">Uploaded ' + escapeHtml(att.createdAt || '') + '</div>';
    row.addEventListener('click', () => { closeModal(); cb(att); });
    listEl.appendChild(row);
  });
  document.getElementById('modalOverlay').classList.add('show');
}
function closeModal(){
  document.getElementById('modalOverlay').classList.remove('show');
}

async function loadJobFiles(detailerAtt, drawingsAtt){
  document.getElementById('frameList').innerHTML = '<div class="spinner"></div>';
  const [detailerBytes, drawingsBytes] = await Promise.all([
    downloadAttachmentBytes(AppState.currentJob.sheetId, detailerAtt.id),
    downloadAttachmentBytes(AppState.currentJob.sheetId, drawingsAtt.id)
  ]);
  AppState.detailerBytes = detailerBytes;
  AppState.drawingsBytes = drawingsBytes;

  const detailerPdf = await loadPdf(detailerBytes.slice(0));
  const { header, frames } = await extractDetailerReport(detailerPdf);
  AppState.header = header;
  AppState.frames = frames;

  const saved = Store.getJobState(AppState.currentJob.rowId);
  const savedNames = new Set(saved && saved.done ? saved.done : []);
  AppState.doneSet = new Set(frames.map(f=>f.name).filter(n => savedNames.has(n)));

  renderFrameList();

  AppState.drawingsPdf = await loadPdf(drawingsBytes.slice(0));
  AppState.drawingsPageCount = AppState.drawingsPdf.numPages;
  AppState.drawingsPage = 1;

  setTabbarVisible(true);
  setActiveTab('report');
  showScreen('screen-report');
}

/* =========================================================================
   REPORT TAB — checklist
   ========================================================================= */
function renderFrameList(){
  const list = document.getElementById('frameList');
  list.innerHTML = '';
  AppState.frames.forEach(f => {
    const done = AppState.doneSet.has(f.name);
    const row = document.createElement('div');
    row.className = 'frame-row' + (done ? ' done' : '');
    row.innerHTML =
      '<div class="check">' + (done ? '&#10003;' : '') + '</div>' +
      '<div class="info">' +
        '<div class="name">' + escapeHtml(f.name) + '</div>' +
        '<div class="specs">' + escapeHtml(f.totalLength) + ' &middot; ' +
          escapeHtml(f.fasteners) + ' fasteners &middot; ' + escapeHtml(f.totalWeight) +
        '</div>' +
      '</div>';
    row.addEventListener('click', () => {
      if(AppState.doneSet.has(f.name)) AppState.doneSet.delete(f.name);
      else AppState.doneSet.add(f.name);
      persistProgress();
      renderFrameList();
    });
    list.appendChild(row);
  });
  document.getElementById('doneCount').textContent = AppState.doneSet.size;
  document.getElementById('totalCount').textContent = AppState.frames.length;
}

function persistProgress(){
  if(!AppState.currentJob) return;
  Store.setJobState(AppState.currentJob.rowId, { done: Array.from(AppState.doneSet) });
}

/* =========================================================================
   SAVE PROGRESS — annotate, then upload as a new version of the same
   "IN PROGRESS" attachment (never a fresh duplicate each time).
   ========================================================================= */
document.getElementById('btnSaveProgress').addEventListener('click', async () => {
  if(!AppState.currentJob || !AppState.detailerBytes){ return; }
  const btn = document.getElementById('btnSaveProgress');
  btn.disabled = true;
  btn.textContent = 'Saving…';
  try{
    const annotated = await annotateDetailerPdf(AppState.detailerBytes.slice(0), AppState.frames, AppState.doneSet);
    const num = (AppState.header.sectionTitle || '').split('_')[0] || '';
    const namePart = (AppState.header.sectionTitle || 'Report').split('_').slice(1).join(' ') || AppState.header.sectionTitle || 'Report';
    const filename = 'IN PROGRESS: ' + num + ' - ' + namePart.toUpperCase() + '.pdf';

    // Re-resolve immediately before writing — never trust a cached attachment ID.
    const existing = await resolveLiveAttachment(AppState.currentJob.sheetId, AppState.currentJob.rowId, filename);

    if(existing){
      await uploadAttachmentBytes(AppState.currentJob.sheetId,
        { attachmentId: existing.id, filename, mode: 'version' }, annotated);
    } else {
      await uploadAttachmentBytes(AppState.currentJob.sheetId,
        { rowId: AppState.currentJob.rowId, filename, mode: 'new' }, annotated);
    }
    toast('Uploaded "' + filename + '" to Smartsheet', 'ok');
  }catch(e){
    toast('Save failed: ' + e.message, 'err');
  }finally{
    btn.disabled = false;
    btn.textContent = 'Save Progress';
  }
});

/* =========================================================================
   DRAWINGS TAB — page viewer with pinch-zoom / pan
   ========================================================================= */
let zoomState = { scale:1, panX:0, panY:0 };

async function renderDrawingPage(){
  if(!AppState.drawingsPdf) return;
  const page = await AppState.drawingsPdf.getPage(AppState.drawingsPage);
  const viewport0 = page.getViewport({scale:1});
  const container = document.getElementById('drawingsViewport');
  const scale = Math.min(
    (container.clientWidth - 20) / viewport0.width,
    (container.clientHeight - 20) / viewport0.height
  );
  const viewport = page.getViewport({scale});
  const canvas = document.getElementById('drawingCanvas');
  canvas.width = viewport.width;
  canvas.height = viewport.height;
  const ctx = canvas.getContext('2d');
  await page.render({canvasContext: ctx, viewport}).promise;

  zoomState = { scale:1, panX:0, panY:0 };
  applyZoom();

  document.getElementById('pageIndicator').textContent =
    'Page ' + AppState.drawingsPage + ' / ' + AppState.drawingsPageCount;
  document.getElementById('drawingsPrev').style.display = AppState.drawingsPage > 1 ? 'block' : 'none';
  document.getElementById('drawingsNext').style.display = AppState.drawingsPage < AppState.drawingsPageCount ? 'block' : 'none';
}

function applyZoom(){
  const canvas = document.getElementById('drawingCanvas');
  canvas.style.transform = 'translate(' + zoomState.panX + 'px,' + zoomState.panY + 'px) scale(' + zoomState.scale + ')';
}

document.getElementById('drawingsPrev').addEventListener('click', () => {
  if(AppState.drawingsPage > 1){ AppState.drawingsPage--; renderDrawingPage(); }
});
document.getElementById('drawingsNext').addEventListener('click', () => {
  if(AppState.drawingsPage < AppState.drawingsPageCount){ AppState.drawingsPage++; renderDrawingPage(); }
});

(function(){
  const vp = document.getElementById('drawingsViewport');
  let pointers = {};
  let startDist = 0, startScale = 1;
  let startMid = {x:0,y:0}, startPan = {x:0,y:0};
  let lastTap = 0;

  vp.addEventListener('pointerdown', e => {
    pointers[e.pointerId] = {x:e.clientX, y:e.clientY};
    const ids = Object.keys(pointers);
    if(ids.length === 2){
      const [a,b] = ids.map(id=>pointers[id]);
      startDist = Math.hypot(a.x-b.x, a.y-b.y);
      startScale = zoomState.scale;
      startMid = {x:(a.x+b.x)/2, y:(a.y+b.y)/2};
      startPan = {x:zoomState.panX, y:zoomState.panY};
    } else if(ids.length === 1){
      startPan = {x:zoomState.panX - e.clientX, y:zoomState.panY - e.clientY};
      const now = Date.now();
      if(now - lastTap < 280){
        zoomState = {scale:1,panX:0,panY:0}; applyZoom();
      }
      lastTap = now;
    }
  });
  vp.addEventListener('pointermove', e => {
    if(!pointers[e.pointerId]) return;
    pointers[e.pointerId] = {x:e.clientX, y:e.clientY};
    const ids = Object.keys(pointers);
    if(ids.length === 2){
      const [a,b] = ids.map(id=>pointers[id]);
      const dist = Math.hypot(a.x-b.x, a.y-b.y);
      zoomState.scale = Math.max(1, Math.min(6, startScale * (dist/startDist)));
      applyZoom();
    } else if(ids.length === 1 && zoomState.scale > 1){
      zoomState.panX = startPan.x + e.clientX;
      zoomState.panY = startPan.y + e.clientY;
      applyZoom();
    }
  });
  ['pointerup','pointercancel','pointerleave'].forEach(evt=>{
    vp.addEventListener(evt, e => { delete pointers[e.pointerId]; });
  });
})();

/* =========================================================================
   UTIL
   ========================================================================= */
function escapeHtml(s){
  return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  }[c]));
}

/* =========================================================================
   BOOT
   ========================================================================= */
function boot(){
  if(!Store.isConfigured()){
    showScreen('screen-setup');
    setTabbarVisible(false);
    return;
  }
  setTabbarVisible(true);
  setActiveTab('jobs');
  showScreen('screen-jobs');
  loadJobs();
}
boot();
